{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/file-worker.ts": { "maxDuration": 300 },
    "api/ai-queue.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "qmrmed-ai",
          "retryAfterSeconds": 60
        }
      ]
    }
  }
}
