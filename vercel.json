{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs22.x",
      "includeFiles": ["miniapp/**"]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/miniapp(?:/(.*))?", "dest": "/api/index.ts" },
    { "src": "/", "dest": "/api/index.ts" }
  ]
}
