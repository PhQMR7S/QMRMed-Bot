{
  "name": "qmrmed-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone QMRMed Telegram learning bot",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx --import ./src/file-ai-preload.ts src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "vercel-build": "prisma generate && npm run db:push:deploy && npm run check && node scripts/prepare-vercel.mjs && node scripts/set-telegram-webhook.mjs",
    "start": "node --import ./dist/src/file-ai-preload.js dist/src/index.js",
    "start:miniapp": "NODE_ENV=production node dist/src/miniapp-server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:deploy": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "content:sync": "tsx src/sync-drive.ts",
    "check-drive": "tsx scripts/check-drive.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke:bot": "tsx scripts/smoke-test.ts",
    "check:telegram": "tsx scripts/check-bot-surface.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/queue": "^0.5.1",
    "dotenv": "^17.2.2",
    "grammy": "^1.38.2",
    "unpdf": "^1.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "overrides": { "deepmerge-ts": "^8.0.2" }
}
