{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "api/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["src/file-ai-v2.ts"]
}
